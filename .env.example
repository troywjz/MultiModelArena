# 使用 fake provider 跑离线端到端流程
ARENA_MODELS=fake_architect,fake_reviewer

ARENA_MODEL_FAKE_ARCHITECT_PROVIDER=fake
ARENA_MODEL_FAKE_ARCHITECT_NAME=fake-architect
ARENA_MODEL_FAKE_ARCHITECT_ROLE_HINT=架构评审者

ARENA_MODEL_FAKE_REVIEWER_PROVIDER=fake
ARENA_MODEL_FAKE_REVIEWER_NAME=fake-reviewer
ARENA_MODEL_FAKE_REVIEWER_ROLE_HINT=测试与质量审查者

# OpenAI-compatible 示例。不要把真实 API Key 提交到仓库。
# ARENA_MODELS=deepseek_chat,qwen_max
# ARENA_MODEL_DEEPSEEK_CHAT_PROVIDER=openai_compatible

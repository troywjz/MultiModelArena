# 本文件是配置模板。复制为 .env 后填入真实地址和 API Key。
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# 当前启用：全部已配置模型。正式运行前可按成本删减 alias。
ARENA_MODELS=minimax_t01,minimax_t05,minimax_t10,kimi,qwen,qwen_max,aliyun_deepseek,glm,deepseek,mimo,seed,seed_pro
ARENA_OUTPUT_DIR=runs
# true 时 OpenAI-compatible 请求不使用环境变量或 Windows 系统代理。
ARENA_DISABLE_PROXY=true

# 参考答案语义评分。默认关闭，避免未准备 API Key 时增加额外调用成本。
# 启用后，assessment-run 会调用 OpenAI-compatible embeddings 接口，把模型回答与本地参考答案做余弦相似度比较。
# 离线测试可直接运行：python -m arena assessment-run --provider fake --embedding-provider fake
# 硅基流动当前可用示例模型：netease-youdao/bce-embedding-base_v1。
# dimensions: None 或留空时请求不传 dimensions；bce-embedding-base_v1 默认 768 维。
# encoding_format: 默认 float。
# batch_size: 每批向量化文本数，默认 16。
# similarity_floor / similarity_ceiling: 把余弦相似度映射到 0-10 分的下限和上限，默认 0.55 / 0.85。
# role_weight: 语义角色适配分融合到角色评分的权重，默认 0.35。
ARENA_EMBEDDING_ENABLED=false
ARENA_EMBEDDING_PROVIDER=openai_compatible
ARENA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
ARENA_EMBEDDING_API_KEY=
ARENA_EMBEDDING_MODEL=netease-youdao/bce-embedding-base_v1
ARENA_EMBEDDING_DIMENSIONS=None
ARENA_EMBEDDING_ENCODING_FORMAT=float
ARENA_EMBEDDING_BATCH_SIZE=16
ARENA_EMBEDDING_TIMEOUT_SECONDS=120
ARENA_EMBEDDING_RETRY_COUNT=1
ARENA_EMBEDDING_DISABLE_PROXY=false
ARENA_EMBEDDING_CACHE_PATH=.arena-cache/embedding-cache.sqlite3
ARENA_EMBEDDING_SIMILARITY_FLOOR=0.55
ARENA_EMBEDDING_SIMILARITY_CEILING=0.85
ARENA_EMBEDDING_ROLE_WEIGHT=0.35

# 默认生成参数。可按模型单独调整。
# temperature: 控制随机性。Kimi 只能使用 1.0；MiniMax 保留 0.1 / 0.5 / 1.0 三档温度。
# max_tokens: 最大输出 token。None 或留空时请求不传该字段，使用模型服务默认值。
# top_p: nucleus sampling。None 或留空时请求不传该字段，使用模型服务默认值。
# timeout_seconds: 单次请求超时，默认 60
# retry_count: 5xx/429/网络错误重试次数，默认 0

ARENA_MODEL_MINIMAX_T01_PROVIDER=anthropic_compatible
ARENA_MODEL_MINIMAX_T01_BASE_URL=https://api.minimaxi.com/anthropic/v1
ARENA_MODEL_MINIMAX_T01_API_KEY=
ARENA_MODEL_MINIMAX_T01_MODEL_NAME=MiniMax-M2.7
ARENA_MODEL_MINIMAX_T01_TEMPERATURE=0.1
ARENA_MODEL_MINIMAX_T01_MAX_TOKENS=None
ARENA_MODEL_MINIMAX_T01_TOKEN_LIMIT_FIELD=max_completion_tokens
ARENA_MODEL_MINIMAX_T01_TOP_P=None
ARENA_MODEL_MINIMAX_T01_TIMEOUT_SECONDS=600
ARENA_MODEL_MINIMAX_T01_RETRY_COUNT=0


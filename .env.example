# ARENA_MODEL_DEEPSEEK_CHAT_API_KEY=sk-...
# ARENA_MODEL_DEEPSEEK_CHAT_NAME=deepseek-chat
# ARENA_MODEL_QWEN_MAX_PROVIDER=openai_compatible
# ARENA_MODEL_QWEN_MAX_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

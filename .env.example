# 本文件是配置模板。复制为 .env 后填入真实地址和 API Key。
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# 当前启用：minimax 三档温度。后续要启用其他模型，把别名追加到 ARENA_MODELS。
ARENA_MODELS=minimax_t01,minimax_t04,minimax_t08
# 可追加：kimi,qwen,glm,deepseek,mimo,seed
ARENA_OUTPUT_DIR=runs

# 默认生成参数。可按模型单独调整。
# temperature: 控制随机性。minimax 预留 0.1 / 0.4 / 0.8 三档。
# max_tokens: 最大输出 token。当前任务需要简短但充分的结构化核心答案，推荐默认 1024。
# top_p: nucleus sampling，默认 1.0
# timeout_seconds: 单次请求超时，默认 60
# retry_count: 5xx/429/网络错误重试次数，默认 0

ARENA_MODEL_MINIMAX_T01_PROVIDER=openai_compatible
ARENA_MODEL_MINIMAX_T01_BASE_URL=
ARENA_MODEL_MINIMAX_T01_API_KEY=
ARENA_MODEL_MINIMAX_T01_MODEL_NAME=
ARENA_MODEL_MINIMAX_T01_TEMPERATURE=0.1
ARENA_MODEL_MINIMAX_T01_MAX_TOKENS=1024
ARENA_MODEL_MINIMAX_T01_TOP_P=1.0
ARENA_MODEL_MINIMAX_T01_TIMEOUT_SECONDS=60
ARENA_MODEL_MINIMAX_T01_RETRY_COUNT=0

